# Chave da API da Anthropic (obrigatória para rodar o agente e os testes e2e). Copie para .env e preencha.
ANTHROPIC_API_KEY=
# Modelo usado pelo agente (decisão D4: Claude Haiku 5.5).
EMPORIO_MODELO=claude-haiku-5-5
# Data de referência ("hoje") para pedidos e promoções, no formato AAAA-MM-DD (decisão DD1).
REFERENCE_DATE=2026-03-31
# Máximo de turnos de conversa mantidos na memória do histórico.
HISTORICO_MAX_TURNOS=10
# Se true, salva transcripts .md das conversas (true/false).
SALVAR_TRANSCRIPTS=false
# (Opcional) Pasta com os CSVs. Padrão: data/ na raiz do repositório.
# EMPORIO_DADOS_DIR=
