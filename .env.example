# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.

# Provedor de IA: gemini (padrão, tem camada gratuita) ou anthropic.
EMPORIO_PROVEDOR=gemini
# Chave do Gemini (obrigatória com EMPORIO_PROVEDOR=gemini). Crie uma chave gratuita no Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo. Vazio = padrão do provedor (gemini: gemini-3.5-flash-lite; anthropic: claude-haiku-5-5).
# Alternativa documentada no Gemini: gemini-3.8-flash (indisponível no free tier, 503/504 em 2026-11-01). Não misture modelo de um provedor com o outro.
EMPORIO_MODELO=
# Chave da Anthropic (opcional; só com EMPORIO_PROVEDOR=anthropic). O adaptador da Anthropic não foi validado com chamadas reais.
ANTHROPIC_API_KEY=
# Data de referência ("hoje") para pedidos e promoções, no formato AAAA-MM-DD (decisão DD1).
REFERENCE_DATE=2026-03-31
# (Opcional) Fixa o "agora" do agente, AAAA-MM-DDTHH:MM, fuso America/Campo_Grande. Vazio = data de referência + hora do relógio (T23).
# EMPORIO_AGORA=
# Máximo de turnos de conversa mantidos na memória do histórico.
HISTORICO_MAX_TURNOS=10
# Se true, salva transcripts .md das conversas em transcripts/ (true/false).
SALVAR_TRANSCRIPTS=false
# (Opcional) Pasta com os CSVs. Padrão: data/ na raiz do repositório.
# EMPORIO_DADOS_DIR=
